# Database connection string for PostgreSQL
# Matches local docker-compose.yml configuration (port 5433):
DATABASE_URL=postgresql://resourceguard:localdevpassword@localhost:5433/resourceguard

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# Allowed CORS origins (comma-separated). Defaults to local Vite development URLs:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
